{
  "name": "@aboutbits/react-pagination",
  "version": "3.3.0",
  "description": "Pagination hooks for React",
  "author": "About Bits",
  "license": "MIT",
  "homepage": "https://github.com/aboutbits/react-pagination",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aboutbits/react-pagination"
  },
  "bugs": {
    "url": "https://github.com/aboutbits/react-pagination/issues"
  },
  "keywords": [
    "react",
    "query",
    "pagination",
    "zod"
  ],
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "prettier": "@aboutbits/prettier-config",
  "files": [
    "readme.md",
    "dist"
  ],
  "engines": {
    "npm": ">=11",
    "node": "^26"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "eslint --cache",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest watch --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "checks": "npm run test && npm run lint && npm run typecheck",
    "prepublishOnly": "npm run checks",
    "prepare": "npm run build",
    "preversion": "npm run checks",
    "version": "git add -A src",
    "postversion": "git push && git push --tags"
  },
  "devDependencies": {
    "@aboutbits/eslint-config": "^6.1.0",
    "@aboutbits/prettier-config": "^2.0.2",
    "@aboutbits/ts-config": "^1.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1",
    "next": "^16.4.6",
    "next-router-mock": "^1.0.5",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "react": "^19.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "exports": {
    ".": "./dist/index.js",
    "./in-memory": "./dist/in-memory/index.js",
    "./in-memory/zod": "./dist/in-memory/zod.js",
    "./next-router": "./dist/next-router/index.js",
    "./next-router/zod": "./dist/next-router/zod.js",
    "./package.json": "./package.json"
  }
}
